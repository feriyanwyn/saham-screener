# ====================================================================
# AI-Powered Indonesian Stock Prediction & Scalping Assistant (.env)
# ====================================================================

# Environment Mode: development / production / testing
APP_ENV=development
DEBUG=True

# Database Configuration
# Default: SQLite lokal untuk kemudahan setup instan, atau PostgreSQL untuk produksi
DATABASE_URL=sqlite:///./data/idx_scalper.db
# PostgreSQL alternatif: postgresql://user:password@localhost:5432/idx_scalper

# Market Data Provider Configuration
# Pilihan: 'invezgo', 'apicoid', 'yfinance', 'mock'
DEFAULT_DATA_PROVIDER=yfinance

# Invezgo API Credentials (https://invezgo.com)
INVEZGO_API_KEY=
INVEZGO_BASE_URL=https://api.invezgo.com

# Api.co.id Credentials (https://api.co.id)
APICOID_API_KEY=
APICOID_BASE_URL=https://use.api.co.id

# Trading & Risk Management Defaults
INITIAL_CAPITAL_IDR=10000000.00
MAX_RISK_PER_TRADE_PCT=0.015
MAX_DAILY_LOSS_PCT=0.03
MAX_OPEN_POSITIONS=3
BROKER_BUY_FEE_PCT=0.0019
BROKER_SELL_FEE_PCT=0.0029
MIN_RISK_REWARD_RATIO=1.5
MIN_CLEAN_PROFIT_PCT=0.012

# Scalping Parameters
SCALPING_TIMEFRAME=5M
TREND_TIMEFRAME=1D
SLIPPAGE_TOLERANCE_TICKS=1
